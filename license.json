
import base64, zlib
from Crypto.Cipher import AES
from hashlib import sha256

_key = [217, 207, 1, 148, 55, 252, 195, 255, 60, 170, 162, 140, 236, 158, 229, 244, 138, 85, 161, 59, 243, 144, 87, 255, 238, 50, 96, 7, 20, 106, 241, 253]

cipher = AES.new(bytes(_key), AES.MODE_ECB)
data = base64.b64decode(b'')
